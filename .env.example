# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real keys.

# OpenAI — chat agent (gpt-4o-mini) + embeddings (text-embedding-3-small)
OPENAI_API_KEY=sk-proj-...

# Tavily — web search tool, locked to wiseuptools.com
TAVILY_API_KEY=tvly-...

# Gmail app password — the email_owner tool sends lead emails via SMTP
GMAIL_APP_PASSWORD=...

# Embedding backend for the Chroma index (leave as openai)
WISEUP_EMBED_BACKEND=openai

# LangSmith tracing (optional — set LANGSMITH_TRACING=false to disable)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=wiseup
